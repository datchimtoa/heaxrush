{
  "name": "hexa-rush",
  "version": "0.1.0",
  "private": true,
  "description": "Hexa Rush practice game and Telegram authentication backend",
  "license": "GPL-3.0-or-later",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.cjs",
    "migrate": "node --env-file-if-exists=.env server/migrate.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:postgres": "node scripts/test-postgres.cjs",
    "check:release": "node --env-file-if-exists=.env scripts/release-check.cjs",
    "preview:renew": "node scripts/preview-tunnel.cjs renew",
    "preview:watch": "node scripts/preview-tunnel.cjs watch",
    "preview:status": "node scripts/preview-tunnel.cjs status"
  },
  "dependencies": {
    "express": "4.22.3",
    "pg": "8.23.1"
  }
}