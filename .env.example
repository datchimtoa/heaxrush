# Copy to .env locally. Never commit real credentials.
NODE_ENV=development
PORT=8001
APP_ORIGIN=http://localhost:8001
DATABASE_URL=
TELEGRAM_BOT_TOKEN=
# Optional: enables non-paying referrals. Use your real Main Mini App bot username.
TELEGRAM_BOT_USERNAME=
# AdsGram preparation. Keep Reward (numeric) separate from Interstitial (int-...) IDs.
# No live rewarded ads or payouts are enabled by setting this ID.
ADSGRAM_REWARDED_BLOCK_ID=
# Explicit development-only SDK check; production rejects true.
ADSGRAM_DEBUG=false
# Optional, explicitly enables TLS certificate verification with a custom CA.
# DATABASE_SSL_CA_FILE=/absolute/path/to/postgres-ca.pem