# Copy to .env locally. Never commit real credentials.
NODE_ENV=development
PORT=8001
APP_ORIGIN=http://localhost:8001
DATABASE_URL=
TELEGRAM_BOT_TOKEN=
# Optional: enables non-paying referrals. Use your real Main Mini App bot username.
TELEGRAM_BOT_USERNAME=
# Optional, explicitly enables TLS certificate verification with a custom CA.
# DATABASE_SSL_CA_FILE=/absolute/path/to/postgres-ca.pem